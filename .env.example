# 后端环境变量示例。复制为 .env 填入真实值（.env 已被 git 忽略）。
# backend 启动时会自动读取仓库根目录下的 .env；系统环境变量优先级更高。

# ---- backend（必填）----
DB_PASSWORD=
# Base64 编码、解码后至少 32 字节的随机串，生成方式见 readme.md
JWT_SECRET=

# ---- backend（可选，以下为默认值）----
DB_USERNAME=root
DB_HOST=localhost
DB_PORT=3306
MATCHING_SYSTEM_URL=http://127.0.0.1:3001
BOT_RUNNING_SYSTEM_URL=http://127.0.0.1:3002

# ---- matchingsystem / botrunningsystem（可选）----
BACKEND_URL=http://127.0.0.1:3000

# ---- 三个服务通用（可选）----
# 允许调用内部接口的来源 IP，支持 CIDR，例如 10.0.0.0/8
INTERNAL_ALLOWED_IP=127.0.0.1
