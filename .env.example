# 复制为 .env 填入真实值（.env 已被 git 忽略）。
# docker compose 和本机运行的 backend 读的都是这一份。

# ==================== 必填 ====================

# 应用连接数据库用的密码（账号见 DB_USERNAME）
DB_PASSWORD=
# MySQL 的 root 密码，只在运维时使用，应用不使用
DB_ROOT_PASSWORD=
# 签发 access token 的密钥：Base64 编码、解码后至少 32 字节。生成方式：openssl rand -base64 32
JWT_SECRET=

# ==================== 容器部署（可选，以下为默认值）====================

# 对外的 HTTP / HTTPS 端口
WEB_PORT=80
WEB_TLS_PORT=443
# 证书目录，里面放 fullchain.pem 和 privkey.pem（只在叠加 docker-compose.tls.yml 时使用）
TLS_CERT_DIR=./certs
# 镜像标签
KOB_VERSION=latest
# 服务间内部网络的网段，和已有的 Docker 网络冲突时再改
INTERNAL_SUBNET=172.30.238.0/24
# 设置后 Redis 开启密码校验
REDIS_PASSWORD=

# ==================== 本地开发（可选，以下为默认值）====================
# 用 java -jar / IDE 在本机运行后端时使用；容器部署时这些值由 docker-compose.yml 指定

DB_USERNAME=kob
DB_HOST=localhost
# DB_PORT 和 REDIS_PORT 同时决定 docker-compose.dev.yml 映射到本机的端口，被占用时改这里即可
DB_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
MATCHING_SYSTEM_URL=http://127.0.0.1:3001
BOT_RUNNING_SYSTEM_URL=http://127.0.0.1:3002
BACKEND_URL=http://127.0.0.1:3000
# 允许调用内部接口的来源 IP，支持 CIDR
INTERNAL_ALLOWED_IP=127.0.0.1
# 允许跨域访问的前端地址，多个用逗号分隔
WEB_ORIGINS=http://localhost:8080
# refresh token 的 Cookie 是否只在 HTTPS 下发送
COOKIE_SECURE=false
